{
  "name": "bible-language-tools",
  "private": true,
  "scripts": {
    "dev:greek": "pnpm --filter greek-tools dev",
    "dev:hebrew": "pnpm --filter hebrew-tools dev",
    "build:greek": "pnpm --filter greek-tools build",
    "build:hebrew": "pnpm --filter hebrew-tools build",
    "test": "pnpm -r test:run",
    "typecheck": "pnpm -r typecheck",
    "prepare": "simple-git-hooks"
  },
  "devDependencies": {
    "lint-staged": "^16.4.0",
    "simple-git-hooks": "^2.13.1"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "apps/greek-tools/**/*.{ts,tsx,js,mjs}": [
      "pnpm --filter greek-tools exec biome check --write --no-errors-on-unmatched"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": ["better-sqlite3", "esbuild", "sharp", "simple-git-hooks", "workerd"]
  }
}
