{
  "name": "bible-language-tools",
  "private": true,
  "scripts": {
    "dev:greek": "pnpm --filter greek-tools dev",
    "dev:hebrew": "pnpm --filter hebrew-tools dev",
    "build:greek": "pnpm --filter greek-tools build",
    "build:hebrew": "pnpm --filter hebrew-tools build",
    "test": "pnpm -r test:run",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs,json,jsonc,css}": "biome check --write --no-errors-on-unmatched"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "sharp",
      "simple-git-hooks",
      "workerd"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.10",
    "lint-staged": "^16.4.0",
    "simple-git-hooks": "^2.13.1"
  }
}
