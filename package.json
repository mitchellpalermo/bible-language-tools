{
  "name": "bible-language-tools",
  "private": true,
  "scripts": {
    "dev:greek": "pnpm --filter greek-tools dev",
    "dev:hebrew": "pnpm --filter hebrew-tools dev",
    "build:greek": "pnpm --filter greek-tools build",
    "build:hebrew": "pnpm --filter hebrew-tools build",
    "test": "pnpm -r test:run",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write ."
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "sharp",
      "simple-git-hooks",
      "workerd"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.10"
  }
}
