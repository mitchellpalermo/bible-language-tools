---
import { type AppEntry, hostOf } from '../data/apps';

interface Props {
  app: AppEntry;
}

const { app } = Astro.props;
---

<a class={`card ${app.id}`} href={app.url}>
  <div class="strip" aria-hidden="true"></div>
  <div class="body">
    <div class="glyph" lang={app.glyphLang} dir={app.dir}>{app.glyph}</div>
    <div>
      <div class="lang">{app.language}</div>
      <h2>{app.name}</h2>
      <p>{app.description}</p>
    </div>
    <div class="tags">
      {app.features.map((feature) => <span class="tag">{feature}</span>)}
    </div>
    <div class="open">
      <span>{hostOf(app.url)}</span>
      <i aria-hidden="true">Open →</i>
    </div>
  </div>
</a>
