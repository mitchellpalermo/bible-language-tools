{
	"main": "dist/_worker.js/index.js",
	"name": "greek-tools",
  "compatibility_date": "2026-06-10",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
	"assets": {
		"binding": "ASSETS",
		"directory": "./dist"
	},
  "workers_dev": false,
	"observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}