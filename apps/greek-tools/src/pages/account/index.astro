---
import SyncControls from '../../components/SyncControls';
import Layout from '../../layouts/Layout.astro';

export const prerender = false;

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect('/account/signin?from=/account');
}
---

<Layout title="My Account">
  <div class="max-w-sm mx-auto mt-8">
    <h1 class="text-2xl font-bold mb-2">My Account</h1>
    <p class="text-sm text-gray-500 mb-6">{user.email}</p>

    <div class="border border-gray-200 rounded-lg p-4 mb-6">
      <h2 class="text-sm font-semibold text-gray-700 mb-1">Study sync</h2>
      <SyncControls client:load />
    </div>

    <form method="POST" action="/api/auth/signout">
      <button
        type="submit"
        class="text-sm text-red-600 hover:text-red-700 hover:underline transition-colors"
      >
        Sign out
      </button>
    </form>
  </div>
</Layout>
