---
import Layout from '../../layouts/Layout.astro';

export const prerender = false;

// Better Auth's emailed link verifies the token and redirects here with
// ?token=... on success or ?error=INVALID_TOKEN on failure. Our own POST
// handler redirects back with ?error=invalid or ?error=short.
const token = Astro.url.searchParams.get('token') ?? '';
const error = Astro.url.searchParams.get('error');
const tokenInvalid = !token || error === 'INVALID_TOKEN' || error === 'invalid';
---

<Layout title="Reset Password">
  <div class="max-w-sm mx-auto mt-8">
    <h1 class="text-2xl font-bold mb-2">Reset password</h1>

    {tokenInvalid ? (
      <>
        <p class="text-sm text-red-600 bg-red-50 border border-red-200 rounded-md px-3 py-2 mb-4">
          This reset link is invalid or has expired.
        </p>
        <a
          href="/account/forgot-password"
          class="block text-center w-full bg-blue-600 text-white rounded-md px-4 py-2 text-sm font-semibold hover:bg-blue-700 transition-colors"
        >
          Request a new link
        </a>
      </>
    ) : (
      <>
        <p class="text-sm text-gray-500 mb-6">Choose a new password for your account.</p>

        {error === 'short' && (
          <p class="text-sm text-red-600 bg-red-50 border border-red-200 rounded-md px-3 py-2 mb-4">
            Password must be at least 8 characters.
          </p>
        )}

        <form method="POST" action="/api/auth/reset-password" class="space-y-4">
          <input type="hidden" name="token" value={token} />
          <div>
            <label for="password" class="block text-sm font-medium mb-1">New password</label>
            <input
              id="password"
              name="password"
              type="password"
              required
              minlength="8"
              autocomplete="new-password"
              class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
            />
            <p class="text-xs text-gray-500 mt-1">At least 8 characters</p>
          </div>
          <button
            type="submit"
            class="w-full bg-blue-600 text-white rounded-md px-4 py-2 text-sm font-semibold hover:bg-blue-700 transition-colors"
          >
            Set new password
          </button>
        </form>
      </>
    )}
  </div>
</Layout>
