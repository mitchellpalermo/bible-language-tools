---
import { readAppleConfig } from '@tools/shared/apple-sign-in';
import Layout from '../../layouts/Layout.astro';

export const prerender = false;

if (Astro.locals.user) {
  const from = Astro.url.searchParams.get('from') ?? '/account';
  return Astro.redirect(from.startsWith('/') ? from : '/account');
}

const from = Astro.url.searchParams.get('from') ?? '';

// Apple shows only once its four settings are in place (see @tools/shared/apple-sign-in).
const appleEnabled = readAppleConfig(Astro.locals.runtime?.env) !== null;
---

<Layout title="Sign In">
  <div class="max-w-sm mx-auto mt-8">
    <h1 class="text-2xl font-bold mb-2">Sign in</h1>
    <p class="text-sm text-gray-500 mb-6">
      Access your saved study progress. New? Just sign in with
      {appleEnabled ? 'Google or Apple' : 'Google'} — your account will be created automatically.
    </p>

    <div id="social-signin" data-from={from}>
      <button
        type="button"
        data-provider="google"
        class="w-full flex items-center justify-center gap-3 border border-gray-300 rounded-md px-4 py-2 text-sm font-medium hover:bg-gray-50 transition-colors"
      >
        <svg width="18" height="18" viewBox="0 0 18 18" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M17.64 9.2c0-.637-.057-1.251-.164-1.84H9v3.481h4.844c-.209 1.125-.843 2.078-1.796 2.717v2.258h2.908c1.702-1.567 2.684-3.875 2.684-6.615z" fill="#4285F4"/>
          <path d="M9 18c2.43 0 4.467-.806 5.956-2.184l-2.908-2.258c-.806.54-1.837.86-3.048.86-2.344 0-4.328-1.584-5.036-3.711H.957v2.332C2.438 15.983 5.482 18 9 18z" fill="#34A853"/>
          <path d="M3.964 10.707A5.41 5.41 0 0 1 3.682 9c0-.593.102-1.17.282-1.707V4.961H.957A8.996 8.996 0 0 0 0 9c0 1.452.348 2.827.957 4.039l3.007-2.332z" fill="#FBBC05"/>
          <path d="M9 3.58c1.321 0 2.508.454 3.44 1.345l2.582-2.58C13.463.891 11.426 0 9 0 5.482 0 2.438 2.017.957 4.961L3.964 6.293C4.672 4.166 6.656 3.58 9 3.58z" fill="#EA4335"/>
        </svg>
        Continue with Google
      </button>

      {
        appleEnabled && (
          <button
            type="button"
            data-provider="apple"
            class="mt-3 w-full flex items-center justify-center gap-3 border border-black bg-black text-white rounded-md px-4 py-2 text-sm font-medium hover:bg-neutral-800 transition-colors"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path fill="currentColor" d="M12.152 6.896c-.948 0-2.415-1.078-3.96-1.04-2.04.027-3.91 1.183-4.961 3.014-2.117 3.675-.546 9.103 1.519 12.09 1.013 1.454 2.208 3.09 3.792 3.039 1.52-.065 2.09-.987 3.935-.987 1.831 0 2.35.987 3.96.948 1.637-.026 2.676-1.48 3.676-2.948 1.156-1.688 1.636-3.325 1.662-3.415-.039-.013-3.182-1.221-3.22-4.857-.026-3.04 2.48-4.494 2.597-4.559-1.429-2.09-3.623-2.324-4.39-2.376-2-.156-3.675 1.09-4.61 1.09zM15.53 3.83c.843-1.012 1.4-2.427 1.245-3.83-1.207.052-2.662.805-3.532 1.818-.78.896-1.454 2.338-1.273 3.714 1.338.104 2.715-.688 3.559-1.701"/>
            </svg>
            Continue with Apple
          </button>
        )
      }
    </div>
  </div>
</Layout>

<script>
  import { createAuthClient } from 'better-auth/client';

  const authClient = createAuthClient();
  const group = document.getElementById('social-signin');
  const from = group?.dataset.from ?? '';
  const dest = from.startsWith('/') ? from : '/account';

  for (const button of group?.querySelectorAll<HTMLButtonElement>('[data-provider]') ?? []) {
    const provider = button.dataset.provider as 'google' | 'apple';
    button.addEventListener('click', () => {
      authClient.signIn.social({
        provider,
        callbackURL: `/account/syncing?to=${encodeURIComponent(dest)}`,
      });
    });
  }
</script>
