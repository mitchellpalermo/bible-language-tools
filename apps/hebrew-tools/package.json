{
  "name": "hebrew-tools",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/build-morphhb.mjs && astro build",
    "build:data": "node scripts/build-morphhb.mjs",
    "build:data:force": "node scripts/build-morphhb.mjs --force",
    "build:vocab": "node scripts/build-vocabulary.mjs",
    "build:vocab:check": "node scripts/build-vocabulary.mjs --check",
    "build:morph-codes": "node scripts/extract-morph-codes.mjs",
    "build:morph-codes:check": "node scripts/extract-morph-codes.mjs --check",
    "preview": "astro preview",
    "astro": "astro",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.6.12",
    "posthog-js": "^1.240.4",
    "@astrojs/react": "^4.4.2",
    "@tailwindcss/vite": "^4.1.18",
    "@tools/db": "workspace:*",
    "@tools/shared": "workspace:*",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "astro": "^5.17.1",
    "better-auth": "^1.6.15",
    "drizzle-orm": "^0.44.7",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260609.1",
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "happy-dom": "^20.7.0",
    "vitest": "^4.0.18",
    "wrangler": "^4.68.1"
  }
}
