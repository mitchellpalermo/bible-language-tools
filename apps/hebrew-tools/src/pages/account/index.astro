---
import ResetProgress from '../../components/ResetProgress';
import SyncControls from '../../components/SyncControls';
import Layout from '../../layouts/Layout.astro';

export const prerender = false;

// Signed-out visitors get the page too, not a redirect to sign-in. Progress is
// localStorage-first, so they have review schedules of their own, and this is
// where the reset lives — the Flashcards page links here. `signedIn` comes from
// the server's session, never the `ht-auth` hint cookie.
const user = Astro.locals.user;
---

<Layout title="My Account" description="Your hebrew.tools account and study progress.">
  <div class="max-w-sm mx-auto mt-8">
    <h1 class="text-2xl font-bold mb-2" style="color: var(--color-primary);">My Account</h1>

    {
      user ? (
        <>
          <p class="text-sm text-text-muted mb-6">{user.email}</p>

          <div class="border-2 border-primary/10 rounded-2xl p-4 mb-6 bg-bg-card">
            <h2 class="text-sm font-bold text-text mb-2">Study sync</h2>
            <SyncControls client:load />
          </div>

          <form method="POST" action="/api/auth/signout">
            <button
              type="submit"
              class="w-full border-2 border-coral/30 text-coral rounded-xl px-4 py-2.5 text-sm font-semibold hover:bg-coral/5 hover:border-coral/50 transition-colors"
            >
              Sign out
            </button>
          </form>
        </>
      ) : (
        <div class="border-2 border-primary/10 rounded-2xl p-4 mb-6 bg-bg-card">
          <p class="text-sm text-text-muted mb-3">
            You are not signed in. Your study progress is saved in this browser only.
          </p>
          <a
            href="/account/signin"
            class="inline-block bg-primary text-white rounded-lg px-3 py-1.5 text-sm font-semibold hover:opacity-90 transition-opacity"
          >
            Sign in to sync it
          </a>
        </div>
      )
    }

    <div id="reset-progress" class="mt-12 scroll-mt-6">
      <ResetProgress client:load signedIn={Boolean(user)} />
    </div>
  </div>
</Layout>
