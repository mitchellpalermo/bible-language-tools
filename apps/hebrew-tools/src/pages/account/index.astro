---
import SyncControls from '../../components/SyncControls';
import Layout from '../../layouts/Layout.astro';

export const prerender = false;

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect('/account/signin?from=/account');
}
---

<Layout title="My Account" description="Your hebrew.tools account.">
  <div class="max-w-sm mx-auto mt-8">
    <h1 class="text-2xl font-bold mb-2" style="color: var(--color-primary);">My Account</h1>
    <p class="text-sm text-text-muted mb-6">{user.email}</p>

    <div class="border-2 border-primary/10 rounded-2xl p-4 mb-6 bg-bg-card">
      <h2 class="text-sm font-bold text-text mb-2">Study sync</h2>
      <SyncControls client:load />
    </div>

    <form method="POST" action="/api/auth/signout">
      <button
        type="submit"
        class="w-full border-2 border-coral/30 text-coral rounded-xl px-4 py-2.5 text-sm font-semibold hover:bg-coral/5 hover:border-coral/50 transition-colors"
      >
        Sign out
      </button>
    </form>
  </div>
</Layout>
