---
import Layout from '../../layouts/Layout.astro';

export const prerender = false;

if (Astro.locals.user) {
  const from = Astro.url.searchParams.get('from') ?? '/account';
  return Astro.redirect(from.startsWith('/') ? from : '/account');
}

const from = Astro.url.searchParams.get('from') ?? '';
---

<Layout title="Sign In" description="Sign in to hebrew.tools to save your study progress.">
  <div class="max-w-sm mx-auto mt-8">
    <h1 class="text-2xl font-bold mb-2" style="color: var(--color-primary);">Sign in</h1>
    <p class="text-sm text-text-muted mb-6">
      Save your study progress and pick it up on any device. New here? Just sign in with Google —
      your account is created automatically.
    </p>

    <button
      id="google-signin"
      type="button"
      data-from={from}
      class="w-full flex items-center justify-center gap-3 border-2 border-primary/20 rounded-xl px-4 py-2.5 text-sm font-semibold hover:bg-primary/5 hover:border-primary/40 transition-colors"
    >
      <svg width="18" height="18" viewBox="0 0 18 18" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M17.64 9.2c0-.637-.057-1.251-.164-1.84H9v3.481h4.844c-.209 1.125-.843 2.078-1.796 2.717v2.258h2.908c1.702-1.567 2.684-3.875 2.684-6.615z" fill="#4285F4"/>
        <path d="M9 18c2.43 0 4.467-.806 5.956-2.184l-2.908-2.258c-.806.54-1.837.86-3.048.86-2.344 0-4.328-1.584-5.036-3.711H.957v2.332C2.438 15.983 5.482 18 9 18z" fill="#34A853"/>
        <path d="M3.964 10.707A5.41 5.41 0 0 1 3.682 9c0-.593.102-1.17.282-1.707V4.961H.957A8.996 8.996 0 0 0 0 9c0 1.452.348 2.827.957 4.039l3.007-2.332z" fill="#FBBC05"/>
        <path d="M9 3.58c1.321 0 2.508.454 3.44 1.345l2.582-2.58C13.463.891 11.426 0 9 0 5.482 0 2.438 2.017.957 4.961L3.964 6.293C4.672 4.166 6.656 3.58 9 3.58z" fill="#EA4335"/>
      </svg>
      Continue with Google
    </button>

    <p class="text-xs text-text-muted mt-6">
      Studying still works signed out — your progress is saved in this browser either way. Signing
      in adds a backup and keeps your cards in step across devices.
    </p>
  </div>
</Layout>

<script>
  import { createAuthClient } from 'better-auth/client';

  const authClient = createAuthClient();
  const button = document.getElementById('google-signin');
  const from = button?.dataset.from ?? '';
  const dest = from.startsWith('/') ? from : '/account';

  button?.addEventListener('click', () => {
    // Route through the interstitial so server progress is pulled and merged
    // before the user reaches anything that reads localStorage.
    authClient.signIn.social({
      provider: 'google',
      callbackURL: `/account/syncing?to=${encodeURIComponent(dest)}`,
    });
  });
</script>
