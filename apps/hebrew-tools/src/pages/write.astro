---
import Writing from '../components/Writing';
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Writing Practice"
  description="Practice writing Hebrew by hand with a stylus — letters and whole words, traced, copied, then written from memory."
>
  <div class="mb-6">
    <h1
      class="text-3xl font-bold mb-1"
      style="color: var(--color-primary);"
    >
      Writing Practice
    </h1>
    <p class="text-text-muted">
      Write by hand, then compare against the reference — letters on their own, or whole
      words into a grid of guide boxes. Best with a stylus: an Apple Pencil gives
      pressure-sensitive ink and lets you rest your palm on the screen.
    </p>
  </div>

  <Writing client:load />
</Layout>
