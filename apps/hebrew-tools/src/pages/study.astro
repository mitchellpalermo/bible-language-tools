---
import Layout from '../layouts/Layout.astro';
import { studyModes } from '../lib/study-modes';

// The hub behind the Study nav group — the same page greek.tools has at /study.
// A group heading is a destination, not just a label (see SiteNav), so this
// page has to exist; adding a study mode means a mode in lib/study-modes.ts, which
// this page and Layout.astro's nav both read.
//
// Today's Session (#184) sits above the modes: it is the routine, and the
// modes are what it is made of. Each budget is a link that starts a session
// straight away (`/today?start=20`), so a session is one tap from here.
const budgets = [20, 45, 90] as const;
---

<Layout title="Study" description="Flashcards and paradigm drills for Biblical Hebrew.">

  <div class="pt-10 pb-4">
    <h1 class="text-3xl font-extrabold" style="color: var(--color-primary);">Study</h1>
    <p class="text-text-muted mt-1 text-sm">Start today’s session, or pick a mode and get to work.</p>
  </div>

  <section
    aria-labelledby="today-heading"
    class="max-w-3xl mb-8 bg-bg-card rounded-2xl shadow-sm border border-white overflow-hidden"
  >
    <div class="h-1.5 w-full" style="background: var(--color-primary);"></div>
    <div class="p-6 space-y-4">
      <div>
        <h2 id="today-heading" class="text-lg font-bold" style="color: var(--color-primary);">
          Today’s Session
        </h2>
        <p class="text-text-muted text-sm leading-relaxed mt-1">
          Due vocabulary, then due paradigm forms, then one short drill — filled to the time you
          have. Pick a length to start.
        </p>
      </div>
      <div class="grid grid-cols-3 gap-3">
        {budgets.map((minutes) => (
          <a
            href={`/today?start=${minutes}`}
            class="text-center px-3 py-3 rounded-xl font-bold text-white hover:opacity-90 transition-opacity"
            style="background: var(--color-primary);"
          >
            {minutes} <span class="text-xs font-semibold opacity-80">min</span>
          </a>
        ))}
      </div>
      <a href="/today" class="inline-block text-sm text-text-muted underline">
        See today’s plan first
      </a>
    </div>
  </section>

  <h2 class="text-sm font-bold text-text-muted uppercase tracking-wider mb-3">Study modes</h2>

  <div class="grid sm:grid-cols-2 gap-5 max-w-3xl pb-16">
    {studyModes.map(({ href, label, description, accentColor, bgColor, icon, detail }) => (
      <a
        href={href}
        class="group block bg-bg-card rounded-2xl shadow-sm hover:shadow-md transition-all duration-200 overflow-hidden border border-white hover:-translate-y-0.5"
      >
        <div class="h-1.5 w-full" style={`background: ${accentColor};`} />
        <div class="p-6">
          <div
            class="w-12 h-12 rounded-xl flex items-center justify-center mb-4"
            style={`background: ${bgColor}; color: ${accentColor};`}
            set:html={icon}
          />
          <h2 class="text-lg font-bold mb-1 group-hover:opacity-80 transition-opacity" style={`color: ${accentColor};`}>
            {label}
          </h2>
          <p class="text-xs font-medium mb-3" style={`color: ${accentColor}; opacity: 0.7;`}>
            {detail}
          </p>
          <p class="text-text-muted text-sm leading-relaxed">
            {description}
          </p>
        </div>
        <div
          class="px-6 pb-4 text-xs font-semibold flex items-center gap-1 opacity-0 group-hover:opacity-100 transition-opacity"
          style={`color: ${accentColor};`}
        >
          Open →
        </div>
      </a>
    ))}
  </div>

</Layout>
