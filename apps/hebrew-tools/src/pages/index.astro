---
import Layout from '../layouts/Layout.astro';

const liveTools = [
  {
    href: '/keyboard',
    icon: '⌨',
    title: 'Type',
    description:
      'Type Biblical Hebrew on your English keyboard using SBL-style phonetic mapping — with nikud (vowel points), dagesh, and automatic final letter forms.',
    accentColor: '#15803D',
    bgColor: '#DCFCE7',
  },
  {
    href: '/flashcards',
    icon: '◫',
    title: 'Flashcards',
    description:
      'Study Biblical Hebrew vocabulary with spaced repetition. Learn the most frequent words first.',
    accentColor: '#7C3AED',
    bgColor: '#F5F3FF',
  },
] as const;

const comingTools = [
  {
    title: 'Daily Verse',
    description: 'One Hebrew Bible verse per day. Build a reading habit with streak tracking.',
    accentColor: '#D97706',
    bgColor: '#FFFBEB',
  },
  {
    title: 'Hebrew Bible Reader',
    description: 'Read the Hebrew Bible chapter by chapter with word-by-word morphological analysis.',
    accentColor: '#0369A1',
    bgColor: '#EFF6FF',
  },
  {
    title: 'Grammar Reference',
    description: 'Paradigm tables for nouns, verbs (all 7 binyanim), pronouns, and prepositions.',
    accentColor: '#F43F5E',
    bgColor: '#FFF1F2',
  },
  {
    title: 'Paradigm Quiz',
    description: 'Drill Hebrew paradigms — fill in the blank for verb forms and noun declensions.',
    accentColor: '#7C3AED',
    bgColor: '#F5F3FF',
  },
  {
    title: 'Transliteration',
    description: 'Convert between pointed Hebrew text and SBL romanized transliteration.',
    accentColor: '#059669',
    bgColor: '#ECFDF5',
  },
] as const;
---

<Layout title="Home">

  <!-- ── Hero ──────────────────────────────────────────────────────────── -->
  <div class="text-center pt-12 pb-10">

    <p
      class="text-5xl mb-4 select-none opacity-20"
      style="font-family: var(--font-hebrew); color: var(--color-primary);"
      aria-hidden="true"
    >
      אָ בָּ גָּ
    </p>

    <h1
      class="text-5xl font-extrabold mb-4 leading-tight"
      style="color: var(--color-primary);"
    >
      hebrew<span style="color: var(--color-accent);">.tools</span>
    </h1>

    <p class="text-lg text-text-muted max-w-xl mx-auto leading-relaxed">
      Free, simple utilities for Biblical Hebrew students. Type, study, and
      strengthen your reading of the Hebrew Bible.
    </p>
  </div>

  <!-- ── Live tools ────────────────────────────────────────────────────── -->
  <div class="max-w-4xl mx-auto mb-12">
    <div class="grid md:grid-cols-3 gap-6">
      {liveTools.map(({ href, icon, title, description, accentColor, bgColor }) => (
        <a
          href={href}
          class="group block bg-bg-card rounded-2xl shadow-sm hover:shadow-md transition-all duration-200 overflow-hidden border border-white hover:-translate-y-0.5"
        >
          <div class="h-1.5 w-full" style={`background: ${accentColor};`} />
          <div class="p-6">
            <div
              class="w-12 h-12 rounded-xl flex items-center justify-center text-xl mb-4 font-mono font-bold"
              style={`background: ${bgColor}; color: ${accentColor};`}
            >
              {icon}
            </div>
            <h2
              class="text-lg font-bold mb-2 group-hover:opacity-80 transition-opacity"
              style={`color: ${accentColor};`}
            >
              {title}
            </h2>
            <p class="text-text-muted text-sm leading-relaxed">
              {description}
            </p>
          </div>
          <div
            class="px-6 pb-4 text-xs font-semibold flex items-center gap-1 opacity-0 group-hover:opacity-100 transition-opacity"
            style={`color: ${accentColor};`}
          >
            Open →
          </div>
        </a>
      ))}
    </div>
  </div>

  <!-- ── Coming soon ───────────────────────────────────────────────────── -->
  <div class="max-w-4xl mx-auto pb-16">
    <p class="text-xs font-bold uppercase tracking-widest text-text-muted mb-4">Coming soon</p>
    <div class="grid md:grid-cols-3 gap-6">
      {comingTools.map(({ title, description, accentColor, bgColor }) => (
        <div class="bg-bg-card rounded-2xl shadow-sm overflow-hidden border border-white opacity-60">
          <div class="h-1.5 w-full" style={`background: ${accentColor};`} />
          <div class="p-6">
            <div
              class="w-12 h-12 rounded-xl flex items-center justify-center text-xl mb-4 font-mono font-bold"
              style={`background: ${bgColor}; color: ${accentColor};`}
            >
              ✦
            </div>
            <h2 class="text-lg font-bold mb-2" style={`color: ${accentColor};`}>
              {title}
            </h2>
            <p class="text-text-muted text-sm leading-relaxed">
              {description}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>

</Layout>
